# Copy this file to .env and fill in the values for local development.
# On Render, set these same names under your service's "Environment" tab instead.

# Printify > Account > Connections > Generate token
PRINTIFY_API_KEY=

# The numeric ID of your Printify API store. Run `npm run shops` to find it.
PRINTIFY_SHOP_ID=

# A long random password you make up. Required to call the test endpoint.
ADMIN_TOKEN=
