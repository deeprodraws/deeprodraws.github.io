# Copy this file to .env and fill in the values for local development.
# On Render, set these same names under your service's "Environment" tab instead.

# --- Printify ---

# Printify > Account > Connections > Generate token
PRINTIFY_API_KEY=

# The numeric ID of your Printify API store. Run `npm run shops` to find it.
PRINTIFY_SHOP_ID=

# A long random password you make up. Required to call the test endpoint.
ADMIN_TOKEN=

# --- Square ---
# Sandbox and production have DIFFERENT tokens and location IDs. Use the
# sandbox ones from the Square Developer Console until you go live.

# "sandbox" (test cards, fake money) or "production" (real money)
SQUARE_ENVIRONMENT=sandbox

# Developer Console > your app > Credentials > Access token
SQUARE_ACCESS_TOKEN=

# Developer Console > your app > Locations > Location ID
SQUARE_LOCATION_ID=

# Developer Console > your app > Webhooks > your subscription > Signature key.
# For local testing with `npm run test-webhook`, any made-up value works.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# The exact URL your webhook subscription points at. Must match Square's
# setting character for character, because it's part of the signature.
# Locally: http://localhost:3001/square-webhook
# On Render: https://YOUR-SERVICE.onrender.com/square-webhook
SQUARE_WEBHOOK_URL=
